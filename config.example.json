{
  "areas": ["Garden", "Work"],
  "system_folders": ["templates", "attachments"],
  "root_allowlist": ["Home.md", "*.base"],
  "states": ["planned", "active", "paused", "done", "cancelled"],
  "states_by_type": {
    "meeting": ["draft"]
  },
  "kinds": {
    "project": {
      "has_status": true,
      "required": ["description"],
      "hub": true,
      "progress": "checkboxes",
      "template": "templates/Project.md",
      "folder": null
    },
    "plan": {
      "has_status": true,
      "required": ["description"],
      "hub": false,
      "progress": "checkboxes",
      "template": "templates/Plan.md",
      "folder": "plans",
      "name_pattern": "\\d{4}-\\d{2}-\\d{2}-[a-z0-9]+(-[a-z0-9]+)*"
    },
    "plan-part": {
      "has_status": true,
      "hub": false
    },
    "meeting": {
      "has_status": true,
      "required": ["description"],
      "hub": false,
      "progress": null,
      "template": "templates/Meeting.md",
      "folder": "meetings",
      "name_pattern": "\\d{4}-\\d{2}-\\d{2} .+"
    }
  },
  "view_properties": ["type", "status", "updated", "description", "progress", "project"],
  "allowed_keys": ["tags", "aliases", "created"],
  "size_cap_bytes": 40960,
  "size_skip_folders": ["attachments", "Garden/meetings"],
  "size_skip_types": [],
  "size_skip_names": ["Seed catalog*"],
  "date_keys": ["updated", "created"],
  "tag_pattern": "[a-z0-9]+(-[a-z0-9]+)*",
  "warn_words": ["und", "oder", "für", "mit", "der", "die", "das"]
}
